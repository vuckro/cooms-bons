  "narrative": {
    "northStar": "Le registre de boutique",
    "overview": "Une interface calme, précise et familière, issue de la clarté des éditions suisses de recettes. Le papier crème, l’encre brune et la répétition des alignements donnent une présence COOMS sans détourner l’attention des actions. La gestion conserve le cadre WordPress ; l’écran de remise a sa propre mise en page, indépendante du thème.\n\nLe système privilégie une lecture immédiate, des contrôles natifs et des états écrits en français. Il ne requiert ni image décorative ni police externe. La simplicité et le fonctionnement prévisible guident les choix.",
    "keyCharacteristics": [
      "Hiérarchie courte et espace utile.",
      "Accent rouge pour les actions de gestion, vert pour la remise disponible.",
      "Surfaces plates, bordures discrètes et chiffres tabulaires.",
      "Statuts formulés en toutes lettres et confirmation explicite."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "Un état est toujours nommé ; la couleur seule ne porte jamais sa signification.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "La profondeur provient du contraste des surfaces et des séparateurs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do conserver les contrôles familiers et les libellés explicites en français.",
      "Do associer chaque état à un texte, même avec un pictogramme.",
      "Do préserver les chiffres tabulaires, le focus visible et le défilement local des tableaux.",
      "Do réserver le vert de l’action de boutique à la remise et sa confirmation."
    ],
    "donts": [
      "Don’t ajouter d’emoji de statut, d’ombre décorative ou de dépendance à une police externe.",
      "Don’t confondre le rouge de marque et une erreur sans libellé explicite.",
      "Don’t montrer une réussite avant la réponse de confirmation du serveur.",
      "Don’t faire dépendre la présentation boutique du thème ou d’AdminKit."
    ]
  }
